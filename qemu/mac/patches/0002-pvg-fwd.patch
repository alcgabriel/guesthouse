+pvg_fwd_read(uint32_t bar, uint64_t offset, unsigned size, uint64_t value) "bar=%u offset=0x%"PRIx64" size=%u value=0x%"PRIx64
+pvg_fwd_write(uint32_t bar, uint64_t offset, unsigned size, uint64_t value) "bar=%u offset=0x%"PRIx64" size=%u value=0x%"PRIx64
+pvg_fwd_interrupt(uint32_t vector) "vector=%u"
+pvg_fwd_reset(void) ""
+
